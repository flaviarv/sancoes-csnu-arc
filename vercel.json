{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/check-names",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/static/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/static/index.html"
    }
  ]
}
